{
  "name": "kphoto",
  "private": true,
  "version": "0.2.0",
  "description": "A demonstration of what is possible with TypeScript 7 and the modern web — a zero-runtime-dependency static blog.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "typecheck:next": "node node_modules/typescript-native-next/bin/tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "typescript-native": "npm:typescript@7.0.2",
    "typescript-native-next": "npm:typescript@7.1.0-dev.20261003.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
